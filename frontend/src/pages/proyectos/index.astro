---
import { getCollection } from 'astro:content'
import CaseStudyCard from '@/components/Projects/CaseStudyCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
---

<BaseLayout title="Proyectos — Ander Fernández">
  <div class="case-study-index">
    <header><p>Proyectos</p><h1>Casos de estudio</h1><p>Producto, datos, IA y software explicados desde el problema hasta la solución.</p></header>
    {projects.length > 0 ? <div class="case-study-grid">{projects.map((project) => <CaseStudyCard project={project} />)}</div> : <p class="case-study-empty">Los primeros casos de estudio se están preparando.</p>}
  </div>
</BaseLayout>
