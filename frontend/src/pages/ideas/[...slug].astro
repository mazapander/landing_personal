---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { ideaPath } from '@/lib/idea-paths.mjs'
import { projectPath } from '@/lib/project-paths.mjs'
import { absoluteUrl } from '@/lib/site.mjs'
import '@/styles/ideas.css'

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft)
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }))
}
interface Props { note: CollectionEntry<'notes'> }
const { note } = Astro.props
const { Content } = await render(note)
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .filter((project) => note.data.projects.some((reference) => reference.id === project.id))
const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Ideas', item: absoluteUrl('/ideas/') },
    { '@type': 'ListItem', position: 3, name: note.data.title, item: absoluteUrl(ideaPath(note.id)) },
  ],
}).replace(/</g, '\\u003c')
---

<BaseLayout title={`${note.data.title} | AnderData`} description={note.data.description}>
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={breadcrumbSchema}></script></Fragment>
  <article class="case-study idea-story">
    <nav aria-label="Miga de pan"><ol><li><a href="/">Inicio</a></li><li><a href="/ideas/">Ideas</a></li><li aria-current="page">{note.data.title}</li></ol></nav>
    <header>
      <p>AD / IDEA · {note.data.category}</p>
      <h1>{note.data.title}</h1>
      <p>{note.data.description}</p>
      <time class="ideas-meta" datetime={note.data.publishedAt.toISOString().slice(0, 10)}>{note.data.publishedAt.toLocaleDateString('es-ES', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })}</time>
    </header>
    <div class="case-study__content"><Content /></div>
    {projects.length > 0 && <section aria-labelledby="related-projects"><h2 id="related-projects">Proyectos relacionados</h2><ul>{projects.map((project) => <li><a href={projectPath(project.id)}>{project.data.title}</a></li>)}</ul></section>}
    <a class="case-study__back" href="/ideas/">← Volver a Ideas</a>
  </article>
</BaseLayout>
