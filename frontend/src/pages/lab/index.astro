---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { labItems } from '@/lib/lab-items.mjs'

const items = labItems(await getCollection('projects'))
---

<BaseLayout title="Lab — Ander Fernández">
  <div class="practice-page">
    <header class="practice-hero">
      <p class="practice-eyebrow">Lab</p>
      <h1>Productos y experimentos que se pueden explorar.</h1>
      <p>Una selección de trabajo público para comprobar cómo conecto producto, datos, IA y software más allá de una descripción.</p>
    </header>
    <section class="lab-grid" aria-label="Productos públicos">
      {items.map((item) => <article>
        <p class="practice-eyebrow">{item.status}</p>
        <h2>{item.title}</h2>
        <p>{item.description}</p>
        <a href={item.href} target="_blank" rel="noreferrer">Explorar <span aria-hidden="true">→</span></a>
      </article>)}
    </section>
  </div>
</BaseLayout>
