---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Home from '@/features/home/Home.astro'

const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID
---

<BaseLayout title="Ander Fernández — Data, IA y producto digital">
  <Fragment slot="head">
    <meta name="description" content="Convierto problemas de negocio en productos de datos, IA y software que funcionan en producción." />

    <link rel="icon" type="image/png" sizes="any" href="/favicon.png?v=2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="shortcut icon" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://anderdata.es" />
    <meta property="og:title" content="Ander Fernández — Data, IA y producto digital" />
    <meta property="og:description" content="Convierto problemas de negocio en productos de datos, IA y software que funcionan en producción." />
    <meta property="og:image" content="https://anderdata.es/image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="AnderData" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@mazapander" />
    <meta name="twitter:title" content="Ander Fernández — Data, IA y producto digital" />
    <meta name="twitter:description" content="Convierto problemas de negocio en productos de datos, IA y software que funcionan en producción." />
    <meta name="twitter:image" content="https://anderdata.es/image.jpg" />
    <script
      is:inline
      defer
      src="https://u.anderdata.es/script.js"
      data-website-id={umamiWebsiteId}
    ></script>
  </Fragment>
  <Home />
</BaseLayout>
