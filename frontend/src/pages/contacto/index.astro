---
import ContactForm from '@/components/Contact/ContactForm'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="Contacto — Ander Fernández" description="Contacto para ideas, proyectos y colaboraciones alrededor de software, datos e IA.">
  <div class="contact-page">
    <header class="conversion-hero">
      <p class="conversion-eyebrow">Contacto</p>
      <h1>¿Tienes una idea o un problema interesante?</h1>
      <p>Si quieres comentar un proyecto, una colaboración, una idea técnica o simplemente compartir contexto, puedes escribirme desde aquí.</p>
      <ContactForm client:load placement="contact_page" />
    </header>
  </div>
</BaseLayout>
