---
import { home } from '@/data/home'
import { projects } from '@/data/projects'

const currentBuildingIds = ['ia-compra-pisos', 'motion-lab', 'stats-feb']
const currentBuilding = currentBuildingIds
  .map((id) => projects.find((project) => project.id === id))
  .filter(Boolean)

const explore = [
  { index: '01', title: 'Proyectos', description: 'Productos, sistemas y herramientas que han pasado de idea a algo que se puede usar.', href: '/proyectos/' },
  { index: '02', title: 'Lab', description: 'Experimentos, prototipos y cosas que todavía estoy intentando entender.', href: '/lab/' },
  { index: '03', title: 'Ideas', description: 'Notas sobre datos, IA, software, arquitectura y decisiones de construcción.', href: '/ideas/' },
]
---

<div class="home-v3">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__inner">
      <div class="home-hero__topline" aria-label="AnderData Personal Technology Lab">
        <span>AD / PERSONAL TECHNOLOGY LAB</span>
        <span class="home-hero__status"><i aria-hidden="true"></i> BUILDING</span>
      </div>

      <div class="home-hero__content">
        <p class="home-hero__identity">Ander Fernández <span>/</span> Product · Data · AI · Engineering</p>
        <h1 id="home-title">I build things with <span>software, data &amp; AI.</span></h1>
        <p class="home-lead">Curiosidad, problemas reales y ganas de llevar ideas hasta algo que funciona.</p>
        <div class="home-actions">
          <a class="home-action home-action--primary" href={home.hero.primaryCta.href} data-track-event="cta_click" data-track-location="home_hero_projects">{home.hero.primaryCta.label} <span aria-hidden="true">→</span></a>
          <a class="home-action home-action--quiet" href="https://github.com/mazapander" target="_blank" rel="noreferrer" data-track-event="profile_open" data-track-location="home_hero">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="home-hero__brand-stamp" aria-hidden="true">
        <img src="/favicon.svg" alt="" width="520" height="520" loading="eager" />
        <span>ANDERDATA / 2026</span>
      </div>
    </div>
  </section>

  <section class="home-building" aria-labelledby="building-title">
    <header class="home-section-heading">
      <div>
        <p class="home-kicker">AD / NOW</p>
        <h2 id="building-title">Currently building</h2>
      </div>
      <p>Trabajo vivo. Proyectos que todavía cambian mientras los construyo.</p>
    </header>

    <div class="building-list">
      {currentBuilding.map((project, index) => project && (
        <article class="building-row">
          <span class="building-index">{String(index + 1).padStart(2, '0')}</span>
          <div class="building-copy">
            <h3><a href={project.url} target={project.url.startsWith('http') ? '_blank' : undefined} rel={project.url.startsWith('http') ? 'noreferrer' : undefined}>{project.title}</a></h3>
            <p>{project.description}</p>
          </div>
          <span class="building-status"><span aria-hidden="true"></span>{project.status}</span>
          <a class="building-arrow" href={project.url} target={project.url.startsWith('http') ? '_blank' : undefined} rel={project.url.startsWith('http') ? 'noreferrer' : undefined} aria-label={`Abrir ${project.title}`}>↗</a>
        </article>
      ))}
    </div>
  </section>

  <section class="home-explore" aria-labelledby="explore-title">
    <header class="home-section-heading home-section-heading--compact">
      <div>
        <p class="home-kicker">AD / EXPLORE</p>
        <h2 id="explore-title">Tres formas de entrar.</h2>
      </div>
    </header>

    <div class="explore-grid">
      {explore.map((item) => (
        <a class="explore-link" href={item.href} data-track-event="navigation_open" data-track-location="home_explore">
          <span class="explore-index">{item.index}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <span class="explore-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-note" aria-labelledby="note-title">
    <p class="home-kicker">AD / NOTES</p>
    <div>
      <h2 id="note-title">Documento lo que aprendo mientras construyo.</h2>
      <a href="/ideas/" data-track-event="navigation_open" data-track-location="home_latest">Ir a Ideas <span aria-hidden="true">→</span></a>
    </div>
  </section>
</div>
