---
import { Picture } from 'astro:assets'
import portrait from '@/assets/ander-portrait.jpg'
import { getCollection } from 'astro:content'
import { home } from '@/data/home'
import { labExtensions, projectFamilies } from '@/data/project-families'
import { projectPath } from '@/lib/project-paths.mjs'
import ProjectMedia from '@/components/Projects/ProjectMedia.astro'

const contentProjects = await getCollection('projects', ({ data }) => !data.draft)
const currentBuildingIds = ['ia-compra-pisos', 'basketball-intelligence', 'anderdata-systems']
const currentBuilding = currentBuildingIds
  .map((id) => contentProjects.find((project) => project.id === id))
  .filter(Boolean)
const familyProjects = projectFamilies.map((family) => ({
  ...family,
  project: contentProjects.find((project) => project.id === family.projectId),
}))
---

<div class="home-v3">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__inner">
      <div class="home-hero__topline" aria-label="AnderData Personal Technology Lab">
        <span>AD / PERSONAL TECHNOLOGY LAB</span>
        <span class="home-hero__status"><i aria-hidden="true"></i> BUILDING</span>
      </div>

      <div class="home-hero__content">
        <p class="home-hero__identity">Ander Fernández <span>/</span> Product · Data · AI · Engineering</p>
        <h1 id="home-title">I build things with <span>software, data &amp; AI.</span></h1>
        <p class="home-lead">Construyo productos de datos para entender la vivienda, visión por computador para baloncesto y automatizaciones sobre mis propios sistemas.</p>
        <div class="home-actions">
          <a class="home-action home-action--primary" href={home.hero.primaryCta.href} data-track-event="cta_click" data-track-location="home_hero_projects">{home.hero.primaryCta.label} <span aria-hidden="true">→</span></a>
          <a class="home-action home-action--quiet" href="https://github.com/mazapander" target="_blank" rel="noreferrer" data-track-event="profile_open" data-track-location="home_hero">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="home-hero__brand-stamp" aria-hidden="true">
        <img src="/companies/anderdata.svg" alt="" width="520" height="520" loading="eager" />
        <span>ANDERDATA / 2026</span>
      </div>

      <nav class="home-hero__activity" aria-label="Proyectos activos">
        <span>NOW / BUILDING</span>
        {currentBuilding.map((project) => project && (
          <a href={projectPath(project.id)}><i aria-hidden="true"></i>{project.data.title}</a>
        ))}
      </nav>
    </div>
  </section>

  <section class="home-building" aria-labelledby="building-title">
    <header class="home-section-heading">
      <div>
        <p class="home-kicker">AD / NOW</p>
        <h2 id="building-title">En construcción</h2>
      </div>
      <p>Productos de datos, herramientas y sistemas que voy construyendo y documentando.</p>
    </header>

    <div class="building-list">
      {currentBuilding.map((project, index) => project && (
        <article class="building-row">
          <span class="building-index">{String(index + 1).padStart(2, '0')}</span>
          <div class="building-copy">
            <h3><a href={projectPath(project.id)}>{project.data.title}</a></h3>
            <p>{project.data.description}</p>
            <span class="building-status"><span aria-hidden="true"></span>{project.data.status}</span>
          </div>
          {(project.data.visual || project.data.media) && <ProjectMedia project={project.data} compact />}
          <a class="building-arrow" href={projectPath(project.id)} aria-label={`Abrir ${project.data.title}`}>→</a>
        </article>
      ))}
    </div>
  </section>

  <section class="home-explore" aria-labelledby="explore-title">
    <header class="home-section-heading">
      <div>
        <p class="home-kicker">AD / LAB</p>
        <h2 id="explore-title">Cuatro historias. Un mismo laboratorio.</h2>
      </div>
      <p>No organizo la web por tecnologías. La organizo por problemas y cosas que estoy intentando construir.</p>
    </header>

    <div class="family-grid">
      {familyProjects.map((family) => (
        <a class="family-link" href={family.href} data-track-event="project_family_open" data-track-location="home_families" data-track-project={family.title}>
          <div class="family-meta"><span>{family.index}</span><span>AD / {family.type}</span></div>
          {family.project && (family.project.data.visual || family.project.data.media) && <ProjectMedia project={family.project.data} compact />}
          <h3>{family.title}</h3>
          <p>{family.description}</p>
          <span class="family-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

    <div class="family-secondary" aria-label="Más áreas del laboratorio">
      {labExtensions.map((item) => (
        <a href={item.href} data-track-event="navigation_open" data-track-location="home_lab_extensions">
          <span>AD / {item.type}</span>
          <strong>{item.title}</strong>
          <p>{item.description}</p>
          <i aria-hidden="true">→</i>
        </a>
      ))}
    </div>
  </section>

  <section class="home-person" aria-labelledby="person-title">
    <Picture src={portrait} alt="Retrato de Ander Fernández" formats={['avif', 'webp']} widths={[160, 320]} sizes="160px" width={160} loading="lazy" />
    <div><p class="home-kicker">AD / BEHIND THE LAB</p><h2 id="person-title">Soy Ander.</h2><p>Ingeniero y product manager de datos e IA. Conecto producto y desarrollo construyendo herramientas para problemas que me encuentro de verdad.</p><a href="/sobre-mi/">Sobre mí →</a></div>
  </section>
  <section class="home-updates" aria-labelledby="updates-title"><p class="home-kicker">AD / BUILD LOG</p><h2 id="updates-title">Últimas actualizaciones</h2><p>Cambios en las historias del laboratorio.</p><ul>{contentProjects.filter((project) => project.data.updatedAt && project.data.updateSummary).sort((a, b) => b.data.updatedAt!.getTime() - a.data.updatedAt!.getTime() || a.id.localeCompare(b.id)).slice(0, 4).map((project) => <li><time datetime={project.data.updatedAt!.toISOString().slice(0, 10)}>{project.data.updatedAt!.toLocaleDateString('es-ES', { timeZone: 'UTC' })}</time><div><a href={projectPath(project.id)}>{project.data.title} →</a><p>{project.data.updateSummary}</p></div></li>)}</ul></section>
  <section class="home-note" aria-labelledby="note-title">
    <p class="home-kicker">AD / NOTES</p>
    <div>
      <h2 id="note-title">Documento lo que aprendo mientras construyo.</h2>
      <a href="/ideas/" data-track-event="navigation_open" data-track-location="home_latest">Ir a Ideas <span aria-hidden="true">→</span></a>
    </div>
  </section>
</div>
