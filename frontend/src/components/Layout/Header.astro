---
const pathname = Astro.url.pathname
const isHome = pathname === '/'
const links = [
  ['Proyectos', '/proyectos/'],
  ['Ideas', '/ideas/'],
  ['Sobre mí', '/sobre-mi/'],
]

const isCurrent = (label: string) => {
  if (label === 'Proyectos') return pathname.startsWith('/proyectos') || pathname.startsWith('/lab') || pathname.startsWith('/automations') || pathname.startsWith('/como-trabajo')
  if (label === 'Ideas') return pathname.startsWith('/ideas') || pathname.startsWith('/notas')
  if (label === 'Sobre mí') return pathname.startsWith('/sobre-mi')
  return false
}
---
<header class={`site-header${isHome ? ' site-header--home' : ''}`}>
  <div class="site-header__inner">
    <a class="site-brand" href="/" data-track-event="navigation_open" data-track-location="header_brand" aria-label="AnderData — Inicio">
      <span class="site-brand__mark" aria-hidden="true"><img src="/companies/anderdata.svg" alt="" width="32" height="32" /></span>
      <span class="site-brand__name">ANDERDATA</span>
    </a>

    <nav class="site-nav" aria-label="Navegación principal">
      {links.map(([label, href]) => (
        <a href={href} aria-current={isCurrent(label) ? 'page' : undefined} data-track-event="navigation_open" data-track-location="header">{label}</a>
      ))}
    </nav>

    <a class="site-header__external" href="/contacto/" aria-current={pathname.startsWith('/contacto') ? 'page' : undefined} data-track-event="contact_open" data-track-location="header">
      Contacto <span aria-hidden="true">→</span>
    </a>

    <details class="site-mobile-menu">
      <summary aria-label="Abrir navegación"><span>Menú</span><span aria-hidden="true">+</span></summary>
      <nav aria-label="Navegación móvil">
        {links.map(([label, href]) => (
          <a href={href} aria-current={isCurrent(label) ? 'page' : undefined} data-track-event="navigation_open" data-track-location="mobile_menu">{label}</a>
        ))}
        <a href="/contacto/" aria-current={pathname.startsWith('/contacto') ? 'page' : undefined} data-track-event="contact_open" data-track-location="mobile_menu">Contacto <span aria-hidden="true">→</span></a>
      </nav>
    </details>
  </div>
</header>
