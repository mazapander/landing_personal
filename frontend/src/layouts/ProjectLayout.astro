---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { projectPath } from '@/lib/project-paths.mjs'
import { absoluteUrl } from '@/lib/site.mjs'
import { ideaPath } from '@/lib/idea-paths.mjs'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProjectTimeline from '@/components/Projects/ProjectTimeline.astro'
import ProjectEvidence from '@/components/Projects/ProjectEvidence.astro'
import ProjectMedia from '@/components/Projects/ProjectMedia.astro'

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props
const { Content, headings } = await render(project)
const sections = headings.filter((heading) => heading.depth === 2)
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .filter((note) => note.data.projects.some((reference) => reference.id === project.id))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || a.id.localeCompare(b.id))
const projectSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'CreativeWork', name: project.data.title, description: project.data.description, url: absoluteUrl(projectPath(project.id)), image: absoluteUrl(`/og/${project.id}.png`), inLanguage: 'es', author: { '@id': absoluteUrl('/sobre-mi/#person') }, ...(project.data.updatedAt ? { dateModified: project.data.updatedAt.toISOString().slice(0, 10) } : {}) }).replace(/</g, '\\u003c')
const relatedProjects = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).filter((item) => item.id !== project.id).slice(0, 3)
const breadcrumbSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: absoluteUrl('/') }, { '@type': 'ListItem', position: 2, name: 'Proyectos', item: absoluteUrl('/proyectos/') }, { '@type': 'ListItem', position: 3, name: project.data.title, item: absoluteUrl(projectPath(project.id)) }] }).replace(/</g, '\\u003c')
---

<BaseLayout title={`${project.data.seoTitle ?? project.data.title} | AnderData`} description={project.data.description} image={`/og/${project.id}.png`}>
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={breadcrumbSchema}></script><script is:inline type="application/ld+json" set:html={projectSchema}></script></Fragment>
  <article class="case-study">
    <nav aria-label="Miga de pan"><ol><li><a href="/">Inicio</a></li><li><a href="/proyectos/">Proyectos</a></li><li aria-current="page">{project.data.title}</li></ol></nav>
    <div class="case-study__hero">
      <header>
        <p>AD / PROJECT STORY · {project.data.status}</p>
        <h1>{project.data.title}</h1>
        <p>{project.data.description}</p>
        {project.data.updatedAt && <p class="project-updated">Historia actualizada <time datetime={project.data.updatedAt.toISOString().slice(0, 10)}>{project.data.updatedAt.toLocaleDateString('es-ES', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' })}</time></p>}
        {project.data.facts.length > 0 && <ul class="case-study__quickfacts" aria-label="Resumen del proyecto">
          {project.data.facts.map((fact) => <li><strong>{fact.value}</strong><span>{fact.label}</span></li>)}
        </ul>}
      </header>
      {(project.data.visual || project.data.media) && <ProjectMedia project={project.data} gallery />}
    </div>
    <ProjectEvidence evidence={project.data.evidence} />
    <ProjectTimeline milestones={project.data.milestones} />
    <div class="case-study__reading">
      {sections.length > 0 && <aside class="case-study__outline">
        <nav aria-label="En esta historia"><p>En esta historia</p><ul>{sections.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>
      </aside>}
      <div class="case-study__content"><Content /></div>
    </div>
    {project.data.architecture.length > 0 && <section aria-labelledby="architecture-title"><h2 id="architecture-title">Arquitectura</h2><dl>{project.data.architecture.map((item) => <div><dt>{item.title}</dt><dd>{item.description}</dd></div>)}</dl></section>}
    {project.data.capabilities.length > 0 && <section aria-labelledby="capabilities-title"><h2 id="capabilities-title">Capacidades</h2><ul>{project.data.capabilities.map((capability) => <li>{capability}</li>)}</ul></section>}
    {project.data.stack.length > 0 && <section aria-labelledby="stack-title"><h2 id="stack-title">Tecnologías</h2><ul class="case-study__tags">{project.data.stack.map((technology) => <li>{technology}</li>)}</ul></section>}
    {project.data.links.length > 0 && <section aria-labelledby="links-title"><h2 id="links-title">Enlaces</h2><ul>{project.data.links.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer" data-track-event="project_open" data-track-location="project_case_link" data-track-project={project.id}>{link.label}</a></li>)}</ul></section>}
    {project.data.externalUrl && <p><a class="case-study__external" href={project.data.externalUrl} target="_blank" rel="noopener noreferrer" data-track-event="project_open" data-track-location="project_case" data-track-project={project.id}>Visitar proyecto <span aria-hidden="true">→</span></a></p>}
    {notes.length > 0 && <section aria-labelledby="related-ideas"><h2 id="related-ideas">Ideas relacionadas</h2><ul>{notes.map((note) => <li><a href={ideaPath(note.id)}>{note.data.title}</a></li>)}</ul></section>}
    <section aria-labelledby="explore-next"><h2 id="explore-next">Sigue explorando</h2><ul>{relatedProjects.map((item) => <li><a href={projectPath(item.id)}>{item.data.title}</a></li>)}</ul><p><a href="/contacto/">Hablemos de este proyecto →</a></p></section>
    <a class="case-study__back" href="/proyectos/" data-track-event="cta_click" data-track-location="project_case_back">← Volver a proyectos</a>
  </article>
</BaseLayout>
