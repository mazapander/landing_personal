---
import type { CollectionEntry } from 'astro:content'
import { projectPath } from '@/lib/project-paths.mjs'
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props
const { Content } = await project.render()
---

<BaseLayout title={`${project.data.title} — Ander Fernández`}>
  <Fragment slot="head"><meta name="description" content={project.data.description} /></Fragment>
  <article class="case-study">
    <nav aria-label="Miga de pan"><ol><li><a href="/">Inicio</a></li><li><a href="/proyectos/">Proyectos</a></li><li aria-current="page">{project.data.title}</li></ol></nav>
    <header>
      <p>{project.data.status}</p>
      <h1>{project.data.title}</h1>
      <p>{project.data.description}</p>
      {project.data.stack.length > 0 && <ul class="case-study__tags">{project.data.stack.map((technology) => <li>{technology}</li>)}</ul>}
    </header>
    <div class="case-study__content"><Content /></div>
    {project.data.architecture.length > 0 && <section aria-labelledby="architecture-title"><h2 id="architecture-title">Arquitectura</h2><dl>{project.data.architecture.map((item) => <div><dt>{item.title}</dt><dd>{item.description}</dd></div>)}</dl></section>}
    {project.data.capabilities.length > 0 && <section aria-labelledby="capabilities-title"><h2 id="capabilities-title">Capacidades</h2><ul>{project.data.capabilities.map((capability) => <li>{capability}</li>)}</ul></section>}
    {project.data.links.length > 0 && <section aria-labelledby="links-title"><h2 id="links-title">Enlaces</h2><ul>{project.data.links.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer" data-track-event="project_open" data-track-location="project_case_link" data-track-project={project.slug}>{link.label}</a></li>)}</ul></section>}
    {project.data.externalUrl && <p><a class="case-study__external" href={project.data.externalUrl} target="_blank" rel="noopener noreferrer" data-track-event="project_open" data-track-location="project_case" data-track-project={project.slug}>Visitar proyecto <span aria-hidden="true">→</span></a></p>}
    <a class="case-study__back" href="/proyectos/" data-track-event="cta_click" data-track-location="project_case_back">← Volver a proyectos</a>
  </article>
</BaseLayout>
