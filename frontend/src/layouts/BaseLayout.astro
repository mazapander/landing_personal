---
import Header from '@/components/layout/Header.astro'
import Footer from '@/components/layout/Footer.astro'
import '@/styles/globals.css'

interface Props { title?: string }
const { title = 'Ander Fernández - Data, AI & Product Builder' } = Astro.props
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <slot name="head" />
    {umamiWebsiteId && <script is:inline defer src="https://u.anderdata.es/script.js" data-website-id={umamiWebsiteId}></script>}
  </head>
  <body class="site-shell">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <script>
      import { attachAnalytics } from '../lib/analytics.mjs'
      attachAnalytics()
    </script>
  </body>
</html>
