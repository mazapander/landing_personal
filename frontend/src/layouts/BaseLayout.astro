---
import Header from '@/components/Layout/Header.astro'
import Footer from '@/components/Layout/Footer.astro'
import { absoluteUrl } from '@/lib/site.mjs'
import '@/styles/globals.css'

interface Props { title?: string; description?: string; image?: string; noindex?: boolean }
const { title = 'Ander Fernández - Data, AI & Product Builder', description = 'Productos de datos, IA y software que funcionan en producción.', image = '/image.jpg', noindex = false } = Astro.props
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID
const canonical = absoluteUrl(Astro.url.pathname)
const imageUrl = absoluteUrl(image)
const schema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, inLanguage: 'es' })
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="any" href="/favicon.png?v=2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="AnderData" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline type="application/ld+json" set:html={schema}></script>
    <slot name="head" />
    {umamiWebsiteId && <script is:inline defer src="https://u.anderdata.es/script.js" data-website-id={umamiWebsiteId}></script>}
  </head>
  <body class="site-shell">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <script>
      import { attachAnalytics } from '../lib/analytics.mjs'
      attachAnalytics()
    </script>
  </body>
</html>
